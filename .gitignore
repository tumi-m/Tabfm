# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/

# Data + artefacts (regenerated by the pipeline).
# `reports/*` rather than `reports/`: git cannot re-include a file inside a
# directory it has already excluded, so the .gitkeep negation would not apply.
data/raw/
data/interim/
reports/*
!reports/.gitkeep

# Model caches
.cache/
*.ckpt
*.safetensors

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
