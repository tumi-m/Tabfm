# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/

# Data + artefacts (regenerated by the pipeline).
# `reports/*` rather than `reports/`: git cannot re-include a file inside a
# directory it has already excluded, so the .gitkeep negation would not apply.
data/raw/
data/interim/
reports/*
!reports/.gitkeep

# Pickled model artifacts are normally build outputs and are not committed —
# they are executable on load, so a pickle arriving via a pull request is a code
# change in disguise. The four small artifacts under artifacts/ are the
# exception, committed deliberately so the Streamlit Community Cloud deployment
# starts instantly: hosted apps sleep after 12 hours idle, and without them every
# wake-up would retrain for minutes.
#
# Review changes to these files as you would review code. To go back to building
# them locally instead: `git rm --cached artifacts/*.pkl` and drop the negation.
artifacts/*
!artifacts/*.pkl

# Model caches
.cache/
*.ckpt
*.safetensors

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
